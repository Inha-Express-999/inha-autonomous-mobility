{
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              1,
              2
            ]
          }
        }
      },
      "then": {
        "properties": {
          "target_speed_kmh": {
            "maximum": 18
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target_speed_kmh": {
            "exclusiveMaximum": 0
          }
        }
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              4,
              5
            ]
          },
          "status": {
            "const": "MANEUVER"
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4,
        5
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "tick": {
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    },
    "target_speed_kmh": {
      "maximum": 50,
      "minimum": -5,
      "title": "Target Speed Kmh",
      "type": "number"
    },
    "steering_angle_rad": {
      "maximum": 1,
      "minimum": -1,
      "title": "Steering Angle Rad",
      "type": "number"
    },
    "emergency_stop": {
      "title": "Emergency Stop",
      "type": "boolean"
    },
    "valid_for_s": {
      "exclusiveMinimum": 0,
      "maximum": 0.3,
      "title": "Valid For S",
      "type": "number"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "lane_error_m": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lane Error M"
    },
    "lane_profile_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lane Profile Hash"
    },
    "transport_phase": {
      "default": "",
      "enum": [
        "",
        "TO_PICKUP",
        "PICKUP_SERVICE",
        "TO_DROPOFF",
        "DROPOFF_SERVICE",
        "RETURN_PENDING",
        "RETURNING"
      ],
      "title": "Transport Phase",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "tick",
    "target_speed_kmh",
    "steering_angle_rad",
    "emergency_stop",
    "valid_for_s",
    "status",
    "reason"
  ],
  "title": "DriveCommand",
  "type": "object"
}
