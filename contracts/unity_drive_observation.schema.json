{
  "$defs": {
    "RayDetection": {
      "additionalProperties": false,
      "properties": {
        "range_m": {
          "maximum": 30,
          "minimum": 0,
          "title": "Range M",
          "type": "number"
        },
        "bearing_rad": {
          "maximum": 1.5707963267948966,
          "minimum": -1.5707963267948966,
          "title": "Bearing Rad",
          "type": "number"
        },
        "lateral_m": {
          "anyOf": [
            {
              "maximum": 35,
              "minimum": -35,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lateral M"
        },
        "forward_m": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": -10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forward M"
        },
        "origin_forward_m": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Forward M"
        }
      },
      "required": [
        "range_m",
        "bearing_rad"
      ],
      "title": "RayDetection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3,
              4
            ]
          }
        }
      },
      "then": {
        "properties": {
          "half_width_m": {
            "type": "number"
          }
        },
        "required": [
          "half_width_m"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "rays": {
            "minItems": 7
          }
        }
      },
      "if": {
        "properties": {
          "obstacle_detection_enabled": {
            "const": false
          }
        },
        "required": [
          "obstacle_detection_enabled"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              3,
              4
            ]
          },
          "rays": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "rear_axle_offset_m": {
            "type": "number"
          },
          "half_length_m": {
            "type": "number"
          }
        },
        "required": [
          "rear_axle_offset_m",
          "half_length_m"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "geometry_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Geometry Hash",
      "type": "string"
    },
    "tick": {
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    },
    "x": {
      "title": "X",
      "type": "number"
    },
    "z": {
      "title": "Z",
      "type": "number"
    },
    "heading_rad": {
      "title": "Heading Rad",
      "type": "number"
    },
    "speed_mps": {
      "maximum": 30,
      "minimum": -15,
      "title": "Speed Mps",
      "type": "number"
    },
    "wheelbase_m": {
      "maximum": 10,
      "minimum": 0.3,
      "title": "Wheelbase M",
      "type": "number"
    },
    "max_steering_rad": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Max Steering Rad",
      "type": "number"
    },
    "sensor_valid": {
      "title": "Sensor Valid",
      "type": "boolean"
    },
    "sensor_age_s": {
      "maximum": 10,
      "minimum": 0,
      "title": "Sensor Age S",
      "type": "number"
    },
    "obstacle_detection_enabled": {
      "default": true,
      "title": "Obstacle Detection Enabled",
      "type": "boolean"
    },
    "rays": {
      "items": {
        "$ref": "#/$defs/RayDetection"
      },
      "maxItems": 64,
      "title": "Rays",
      "type": "array"
    },
    "half_width_m": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 0.1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Half Width M"
    },
    "rear_axle_offset_m": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": -10,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rear Axle Offset M"
    },
    "half_length_m": {
      "anyOf": [
        {
          "maximum": 15,
          "minimum": 0.1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Half Length M"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "geometry_hash",
    "tick",
    "x",
    "z",
    "heading_rad",
    "speed_mps",
    "wheelbase_m",
    "max_steering_rad",
    "sensor_valid",
    "sensor_age_s",
    "rays"
  ],
  "title": "EgoObservation",
  "type": "object"
}
