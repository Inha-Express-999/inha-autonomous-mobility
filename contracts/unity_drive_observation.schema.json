{
  "$defs": {
    "LidarFrame": {
      "additionalProperties": false,
      "properties": {
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "ray_count": {
          "maximum": 8192,
          "minimum": 360,
          "title": "Ray Count",
          "type": "integer"
        },
        "max_range_m": {
          "maximum": 30,
          "minimum": 1,
          "title": "Max Range M",
          "type": "number"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/LidarHit"
          },
          "maxItems": 8192,
          "title": "Hits",
          "type": "array"
        }
      },
      "required": [
        "tick",
        "ray_count",
        "max_range_m",
        "valid",
        "hits"
      ],
      "title": "LidarFrame",
      "type": "object"
    },
    "LidarHit": {
      "additionalProperties": false,
      "properties": {
        "lateral_m": {
          "maximum": 40,
          "minimum": -40,
          "title": "Lateral M",
          "type": "number"
        },
        "forward_m": {
          "maximum": 40,
          "minimum": -40,
          "title": "Forward M",
          "type": "number"
        },
        "entity_class": {
          "default": "unknown",
          "enum": [
            "unknown",
            "static",
            "pedestrian",
            "vehicle"
          ],
          "title": "Entity Class",
          "type": "string"
        }
      },
      "required": [
        "lateral_m",
        "forward_m"
      ],
      "title": "LidarHit",
      "type": "object"
    },
    "LidarScan": {
      "additionalProperties": false,
      "description": "Protocol 6 raw range image (channel-major) without labels or pre-filtering.\n\nBeam directions are leveled to world up; azimuth is clockwise from the\nprojected vehicle forward. Offsets are in the leveled ego frame relative to\nthe localization origin. ``ground_up_m`` is the measured wheel-contact plane\nheight beneath the sensor and ``ground_grade_*`` its grade along leveled\nforward/right (proprioception), not a terrain or map height query.",
      "properties": {
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "max_range_m": {
          "maximum": 30,
          "minimum": 1,
          "title": "Max Range M",
          "type": "number"
        },
        "columns": {
          "maximum": 4096,
          "minimum": 360,
          "title": "Columns",
          "type": "integer"
        },
        "azimuth_start_deg": {
          "maximum": 180,
          "minimum": -180,
          "title": "Azimuth Start Deg",
          "type": "number"
        },
        "azimuth_span_deg": {
          "maximum": 360,
          "minimum": 360,
          "title": "Azimuth Span Deg",
          "type": "number"
        },
        "channel_elevations_deg": {
          "items": {
            "maximum": 90,
            "minimum": -90,
            "type": "number"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Channel Elevations Deg",
          "type": "array"
        },
        "sensor_lateral_m": {
          "maximum": 5,
          "minimum": -5,
          "title": "Sensor Lateral M",
          "type": "number"
        },
        "sensor_forward_m": {
          "maximum": 10,
          "minimum": -10,
          "title": "Sensor Forward M",
          "type": "number"
        },
        "sensor_up_m": {
          "maximum": 10,
          "minimum": -2,
          "title": "Sensor Up M",
          "type": "number"
        },
        "ground_up_m": {
          "maximum": 5,
          "minimum": -5,
          "title": "Ground Up M",
          "type": "number"
        },
        "ground_grade_forward": {
          "maximum": 1,
          "minimum": -1,
          "title": "Ground Grade Forward",
          "type": "number"
        },
        "ground_grade_lateral": {
          "maximum": 1,
          "minimum": -1,
          "title": "Ground Grade Lateral",
          "type": "number"
        },
        "ranges_mm": {
          "items": {
            "maximum": 30000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8192,
          "title": "Ranges Mm",
          "type": "array"
        }
      },
      "required": [
        "tick",
        "valid",
        "max_range_m",
        "columns",
        "azimuth_start_deg",
        "azimuth_span_deg",
        "channel_elevations_deg",
        "sensor_lateral_m",
        "sensor_forward_m",
        "sensor_up_m",
        "ground_up_m",
        "ground_grade_forward",
        "ground_grade_lateral",
        "ranges_mm"
      ],
      "title": "LidarScan",
      "type": "object"
    },
    "RayDetection": {
      "additionalProperties": false,
      "properties": {
        "range_m": {
          "maximum": 30,
          "minimum": 0,
          "title": "Range M",
          "type": "number"
        },
        "bearing_rad": {
          "maximum": 1.5707963267948966,
          "minimum": -1.5707963267948966,
          "title": "Bearing Rad",
          "type": "number"
        },
        "lateral_m": {
          "anyOf": [
            {
              "maximum": 35,
              "minimum": -35,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lateral M"
        },
        "forward_m": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": -10,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forward M"
        },
        "origin_forward_m": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin Forward M"
        }
      },
      "required": [
        "range_m",
        "bearing_rad"
      ],
      "title": "RayDetection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              2,
              3,
              4,
              5,
              6
            ]
          }
        }
      },
      "then": {
        "properties": {
          "half_width_m": {
            "type": "number"
          }
        },
        "required": [
          "half_width_m"
        ]
      }
    },
    {
      "else": {
        "if": {
          "properties": {
            "schema_version": {
              "enum": [
                1,
                2,
                3,
                4
              ]
            }
          }
        },
        "then": {
          "properties": {
            "rays": {
              "minItems": 7
            }
          }
        }
      },
      "if": {
        "properties": {
          "obstacle_detection_enabled": {
            "const": false
          }
        },
        "required": [
          "obstacle_detection_enabled"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              3,
              4
            ]
          },
          "rays": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              4,
              5,
              6
            ]
          }
        }
      },
      "then": {
        "properties": {
          "rear_axle_offset_m": {
            "type": "number"
          },
          "half_length_m": {
            "type": "number"
          }
        },
        "required": [
          "rear_axle_offset_m",
          "half_length_m"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              5,
              6
            ]
          }
        }
      },
      "then": {
        "properties": {
          "lidar": {
            "type": "object"
          },
          "rays": {
            "maxItems": 0
          },
          "obstacle_detection_enabled": {
            "const": true
          }
        },
        "required": [
          "lidar"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "geometry_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Geometry Hash",
      "type": "string"
    },
    "tick": {
      "minimum": 0,
      "title": "Tick",
      "type": "integer"
    },
    "x": {
      "title": "X",
      "type": "number"
    },
    "z": {
      "title": "Z",
      "type": "number"
    },
    "heading_rad": {
      "title": "Heading Rad",
      "type": "number"
    },
    "speed_mps": {
      "maximum": 30,
      "minimum": -15,
      "title": "Speed Mps",
      "type": "number"
    },
    "wheelbase_m": {
      "maximum": 10,
      "minimum": 0.3,
      "title": "Wheelbase M",
      "type": "number"
    },
    "max_steering_rad": {
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Max Steering Rad",
      "type": "number"
    },
    "sensor_valid": {
      "title": "Sensor Valid",
      "type": "boolean"
    },
    "sensor_age_s": {
      "maximum": 10,
      "minimum": 0,
      "title": "Sensor Age S",
      "type": "number"
    },
    "obstacle_detection_enabled": {
      "default": true,
      "title": "Obstacle Detection Enabled",
      "type": "boolean"
    },
    "rays": {
      "items": {
        "$ref": "#/$defs/RayDetection"
      },
      "maxItems": 64,
      "title": "Rays",
      "type": "array"
    },
    "lidar": {
      "anyOf": [
        {
          "$ref": "#/$defs/LidarFrame"
        },
        {
          "$ref": "#/$defs/LidarScan"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lidar"
    },
    "half_width_m": {
      "anyOf": [
        {
          "maximum": 3,
          "minimum": 0.1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Half Width M"
    },
    "rear_axle_offset_m": {
      "anyOf": [
        {
          "maximum": 10,
          "minimum": -10,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rear Axle Offset M"
    },
    "half_length_m": {
      "anyOf": [
        {
          "maximum": 15,
          "minimum": 0.1,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Half Length M"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "geometry_hash",
    "tick",
    "x",
    "z",
    "heading_rad",
    "speed_mps",
    "wheelbase_m",
    "max_steering_rad",
    "sensor_valid",
    "sensor_age_s",
    "rays"
  ],
  "title": "EgoObservation",
  "type": "object"
}
